{
  "name": "stem-ui",
  "version": "0.1.0",
  "private": true,
  "description": "Frontend of Stem, a floating dock for Windows 11 (Svelte 5 + Vite, served inside Tauri 2)",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings && tsc -p tsconfig.node.json",
    "lint": "eslint . && prettier --check . && cd .. && eslint -c ui/eslint.config.js scripts && node scripts/prosecheck.mjs && node scripts/linecap.mjs",
    "format": "prettier --write .",
    "test": "vitest run",
    "e2e:screenshots": "playwright test",
    "tauri": "TAURI_APP_PATH=../src-tauri tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "2.12.4"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@tauri-apps/cli": "2.12.4",
    "@types/node": "22.20.5",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-svelte": "3.23.1",
    "globals": "17.14.0",
    "prettier": "3.9.10",
    "prettier-plugin-svelte": "4.1.1",
    "svelte": "5.57.3",
    "svelte-check": "4.7.8",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "5.1.0"
  }
}
