{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Stem",
  "version": "0.1.0",
  "identifier": "dev.davidcristian.stem",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "withGlobalTauri": false,
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "davidcristian",
    "copyright": "Copyright (C) 2026 davidcristian",
    "homepage": "https://github.com/davidcristian/Cortex-Stem",
    "license": "AGPL-3.0-only",
    "licenseFile": "../LICENSE",
    "category": "Utility",
    "shortDescription": "A floating dock for Windows 11",
    "longDescription": "Stem replaces the Windows taskbar with a floating, centred, magnifying dock for pinned and running apps.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "languages": ["English"],
        "displayLanguageSelector": false
      }
    }
  }
}
